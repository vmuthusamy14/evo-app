{
  "name": "Goal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "milestone",
        "habit"
      ],
      "default": "milestone"
    },
    "completed": {
      "type": "boolean",
      "default": false
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "streak": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "type"
  ]
}
